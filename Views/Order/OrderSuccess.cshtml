@model _25DH110651_MyStore.Models.Order
@{
    ViewBag.Title = "Xác nhận đơn hàng";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="container mt-5 text-center">
    <h2 class="text-success mb-3"><i class="fas fa-check-circle"></i> ĐẶT HÀNG THÀNH CÔNG!</h2>
    <p>Cảm ơn bạn đã mua sắm tại cửa hàng.</p>
    <div class="card mt-4 text-start shadow-sm">
        <div class="card-header bg-info text-white"><h4>Thông tin đơn hàng</h4></div>
        <div class="card-body">
            <p><strong>Mã đơn hàng:</strong> #@Model.OrderID</p>
            <p><strong>Ngày đặt hàng:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
            <p><strong>Tổng số tiền:</strong> <span class="text-danger fw-bold">@Model.TotalAmount.ToString("N0") VNĐ</span></p>
            <p><strong>Trạng thái thanh toán:</strong> @Model.PaymentStatus</p>
            <p><strong>Phương thức thanh toán:</strong> @Model.PaymentMethod</p>
            <p><strong>Phương thức giao hàng:</strong> @Model.DeliveryMethod</p>
            <p><strong>Địa chỉ giao hàng:</strong> @Model.ShippingAddress</p>
        </div>
    </div>
    <div class="card mt-4 text-start shadow-sm">
        <div class="card-header bg-secondary text-white"><h4>Chi tiết đơn hàng</h4></div>
        <div class="card-body">
            <table class="table table-bordered">
                <thead>
                    <tr><th>Sản phẩm</th><th>Số lượng</th><th>Đơn giá</th><th>Tổng giá</th></tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.OrderDetails)
                    {
                        <tr>
                            <td>@item.Product.ProductName</td>
                            <td>@item.Quantity</td>
                            <td>@item.UnitPrice.ToString("N0")</td>
                            <td>@item.TotalPrice.Value.ToString("N0")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="mt-4">@Html.ActionLink("Tiếp tục mua sắm", "Index", "Home", null, new { @class = "btn btn-primary" })</div>
</div>