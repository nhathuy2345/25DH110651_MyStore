<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - My Store</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        .top-banner {
            background-color: #a3e635;
            color: #000;
            text-align: center;
            padding: 8px 0;
            font-weight: 500;
            font-size: 14px;
        }

        .navbar-brand {
            font-size: 26px;
            font-weight: 900;
            letter-spacing: 1px;
            color: #333 !important;
        }
    </style>
</head>
<body>
    <div class="top-banner">Free ship đơn từ 40k, giảm nhiều hơn cùng <strong>FREESHIP XTRA</strong></div>
    <nav class="navbar navbar-expand-lg navbar-light bg-light shadow-sm sticky-top">
        <div class="container">
            <a class="navbar-brand" href="@Url.Action("Index", "Home")">FASTOR</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="navbarContent">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    @Html.Action("MenuCategories", "Home")
                </ul>
                @if (ViewBag.pmmodel != null)
                {
                    @Html.Partial("PersonalMenuPV", (_25DH110651_MyStore.Models.ViewModel.PersonalMenuVM)ViewBag.pmmodel)
                }
            </div>
        </div>
    </nav>
    <div class="container mt-4" style="min-height: 600px;">@RenderBody()</div>
    <footer class="bg-dark text-white py-4 mt-5 text-center">
        <p>&copy; @DateTime.Now.Year - My Store</p>
        <p>Thành viên nhóm: Nguyễn Đình Nhật Huy</p>
    </footer>
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>