<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - My Store</title>

    <!-- SỬA Ở ĐÂY: Dùng Bootstrap 3 và FontAwesome 4 để khớp với class trong slide -->
    <link href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" />

    <!-- Link tới file CSS của bạn -->
    <link rel="stylesheet" href="~/Content/CustomerHome.css" />

    <style>
        /* Chỉnh lại khoảng cách để không bị thanh menu đè lên nội dung */
        body {
            padding-top: 100px;
        }
        /* Chỉnh màu nền thanh menu trên cùng */
        .navbar-default {
            background-color: white;
            border-color: transparent;
        }
    </style>
</head>
<body>
    <!-- Khối Header tổng -->
    <div class="navbar navbar-default navbar-fixed-top">
        <!-- BANNER VOUCHER XANH -->
        <header class="container" style="background-color:lightgreen;">
            <div style="text-align:center; color:green; padding: 5px 0;">
                Free ship đơn từ 40k, giảm nhiều hơn cùng
                <span style="font-weight:bold; font-style:italic;">
                    <span style="color:blue;">FREESHIP</span> XTRA
                </span>
            </div>
        </header>

        <!-- Thanh Menu (Logo và các icon) -->
        <div class="container" style="padding-top: 10px; padding-bottom: 10px;">
            <div class="navbar-header">
                <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>
                <!-- Logo -->
                <a href="@Url.Action("Index", "Home")" class="navbar-brand" style="font-weight:bold; font-size: 24px; color: black;">FASTOR</a>
            </div>

            <div class="navbar-collapse collapse navbar-right">
                <ul class="nav navbar-nav">
                    <!-- Menu Danh mục (Sẽ làm sau) -->
                    <li><a href="#">Danh mục sản phẩm</a></li>

                    <!-- Menu Trang chủ -->
                    <li><a href="@Url.Action("Index", "Home")"><i class="fa fa-home"></i> Trang chủ</a></li>

                    <!-- Menu Tài khoản -->
                    <li class="dropdown">
                        <a href="javascript:void(0)" class="dropdown-toggle" data-toggle="dropdown">
                            <i class="fa fa-user"></i> Tài khoản
                        </a>
                    </li>

                    <!-- Menu Giỏ hàng -->
                    <li>
                        <a href="@Url.Action("Index", "Cart")">
                            <i class="fa fa-shopping-cart"></i> Giỏ hàng (0)
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Body (Phần nội dung thay đổi) -->
    <div class="container" style="margin-top: 20px;">
        @RenderBody()
    </div>

    <!-- Footer -->
    <footer class="bg-light py-4 mt-5 text-center" style="background-color: #f8f9fa; padding: 20px 0; margin-top: 50px; border-top: 1px solid #ddd;">
        <p class="mb-1" style="margin: 0;">©2026 - 25DH110651_MyStore</p>
        <p class="mb-0" style="margin: 0;">Nguyễn Đình Nhật Huy</p>
    </footer>

    <!-- Thêm Javascript của Bootstrap 3 để menu dropdown hoạt động -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>
</body>
</html>