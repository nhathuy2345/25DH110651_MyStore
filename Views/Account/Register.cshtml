@model _25DH110651_MyStore.Models.ViewModel.CustomerVM

@{
    ViewBag.Title = "Đăng ký";
    // Lưu ý: Đã đổi về Layout của khách hàng. Nếu bạn muốn dùng Layout Admin thì đổi lại nhé.
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container" style="max-width: 600px; margin-top: 40px; margin-bottom: 50px;">
    <div class="panel panel-primary">
        <div class="panel-heading">
            <h3 class="panel-title text-center" style="font-size: 24px;">ĐĂNG KÝ TÀI KHOẢN</h3>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Tên đăng nhập <span class="text-danger">*</span></label>
                            @Html.EditorFor(m => m.Username, new { htmlAttributes = new { @class = "form-control", required = "required" } })
                        </div>
                        <div class="form-group">
                            <label>Mật khẩu <span class="text-danger">*</span></label>
                            @Html.PasswordFor(m => m.Password, new { @class = "form-control", required = "required" })
                        </div>
                        <div class="form-group">
                            <label>Xác nhận mật khẩu <span class="text-danger">*</span></label>
                            @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", required = "required" })
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Họ và tên <span class="text-danger">*</span></label>
                            @Html.EditorFor(m => m.CustomerName, new { htmlAttributes = new { @class = "form-control", required = "required" } })
                        </div>
                        <div class="form-group">
                            <label>Email <span class="text-danger">*</span></label>
                            @Html.EditorFor(m => m.CustomerEmail, new { htmlAttributes = new { @class = "form-control", type = "email", required = "required" } })
                        </div>
                        <div class="form-group">
                            <label>Số điện thoại</label>
                            @Html.EditorFor(m => m.CustomerPhone, new { htmlAttributes = new { @class = "form-control" } })
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label>Địa chỉ</label>
                    @Html.EditorFor(m => m.CustomerAddress, new { htmlAttributes = new { @class = "form-control" } })
                </div>

                <div class="form-group text-center" style="margin-top: 20px;">
                    <button type="submit" class="btn btn-success" style="width: 150px;">Đăng ký</button>
                    <a href="@Url.Action("Login", "Account")" class="btn btn-default" style="width: 150px;">Đã có tài khoản?</a>
                </div>
            }
        </div>
    </div>
</div>
