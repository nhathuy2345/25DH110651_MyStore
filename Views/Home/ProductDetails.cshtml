@model _25DH110651_MyStore.Models.ViewModel.ProductDetailsVM
@{
    ViewBag.Title = "ProductDetails";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<style>
    .pro-container {
        background-color: #f8f9fa; /* Màu nền xám nhạt giống ảnh mẫu */
        padding: 20px;
        border-radius: 10px;
        margin-top: 20px;
    }

    .pro-section {
        background-color: white;
        border-radius: 10px;
        padding: 20px;
        box-shadow: 0 0 10px rgba(0,0,0,0.05); /* Tạo bóng đổ nhẹ cho đẹp */
        margin-bottom: 20px;
    }

    .main-image {
        width: 100%;
        max-height: 300px;
        object-fit: contain;
        border: 1px solid #eee;
        padding: 10px;
    }

    .pro-price {
        font-weight: bold;
        font-size: 1.5rem;
        color: red;
    }

    .pro-sale {
        color: gray;
        font-size: 0.9rem;
    }
</style>

<div class="container pro-container">
    <div class="row">
        <!-- Cột 1: Ảnh sản phẩm (Chiếm 3/12) -->
        <div class="col-md-3">
            <div class="pro-section text-center">
                <img src="@Model.product.ProductImage" class="main-image" alt="@Model.product.ProductName" />
            </div>
        </div>

        <!-- Cột 2: Thông tin & Sản phẩm tương tự (Chiếm 6/12) -->
        <div class="col-md-6">
            <div class="pro-section" style="min-height: 350px;">
                <h4><strong>@Html.DisplayFor(model => model.product.ProductName)</strong></h4>
                <p class="pro-sale">Đã bán: @Model.product.OrderDetails.Count</p>
                <p class="pro-price">@Html.DisplayFor(model => model.product.ProductPrice)<sup>₫</sup></p>
                <p>Tủ sách: @Html.DisplayFor(model => model.product.Category.CategoryName)</p>

                <hr />
                <h5><strong>Mô tả</strong></h5>
                <p style="text-align: justify;">@Model.product.ProductDecription</p>
            </div>

            <!-- Gọi Partial View Sản phẩm tương tự -->
            <div class="pro-section">
                @Html.Partial("_PVRelatedProduct", Model)
            </div>
        </div>

        <!-- Cột 3: Thêm vào giỏ & Top bán chạy (Chiếm 3/12) -->
        <div class="col-md-3">
            <!-- Form Thêm vào giỏ -->
            <div class="pro-section">
                <h5><strong>Số lượng</strong></h5>
                @using (Html.BeginForm("ProductDetails", "Home", FormMethod.Get))
                {
                    <div class="mb-3">
                        @Html.TextBoxFor(model => model.quantity, new { @class = "form-control", @type = "number", @min = 1 })
                    </div>

                    <h5><strong>Tạm tính</strong></h5>
                    <p class="text-danger fw-bold">@Model.estimatedValue.ToString("N0")<sup>₫</sup></p>

                    <button type="submit" class="btn btn-info w-100 text-white">Thêm vào giỏ hàng</button>
                }
            </div>

            <!-- Gọi Partial View Top bán chạy -->
            <div class="pro-section">
                @Html.Partial("_PVTopProduct", Model)
            </div>
        </div>
    </div>
</div>