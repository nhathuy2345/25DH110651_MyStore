@model IEnumerable<_25DH110651_MyStore.Models.Product>
@{
    ViewBag.Title = "Danh sách sản phẩm";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="container mt-4">
    <h3 class="text-center text-danger mb-4">DANH SÁCH SẢN PHẨM</h3>
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-3 mb-4">
                <div class="card h-100 shadow-sm">
                    <a href="@Url.Action("ProductDetail", "Home", new { id = item.ProductID })">
                        <img src="@item.ProductImage" class="card-img-top" alt="@item.ProductName" style="height: 200px; object-fit: contain; padding: 10px;">
                    </a>
                    <div class="card-body d-flex flex-column">
                        <a href="@Url.Action("ProductDetail", "Home", new { id = item.ProductID })" class="text-decoration-none text-dark">
                            <h6 class="card-title text-truncate" title="@item.ProductName">@item.ProductName</h6>
                        </a>
                        <p class="text-danger font-weight-bold mt-auto mb-2">@item.ProductPrice.ToString("N0") VNĐ</p>
                        <a href="@Url.Action("ProductDetail", "Home", new { id = item.ProductID })" class="btn btn-outline-primary btn-sm w-100">Xem chi tiết</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>