@model _25DH110651_MyStore.Models.ViewModel.HomeProductVm

<link rel="stylesheet" type="text/css" href="~/Content/MyStyle/CustomerHome.css" />
<!-- Hiển thị danh sách sản phẩm -->
@if (Model.FeaturedProducts != null && Model.FeaturedProducts.Any())
{
    <section class="container-fluid featureProd">
        <h2>Sản phẩm nổi bật</h2>
        <div class="feature-container">
            @foreach (var product in Model.FeaturedProducts)
            {
                <div class="fproduct-item">
                    <div>
                        <a href="@Url.Action("ProductDetails", "Home", new { id = product.ProductID })">
                            <img src="@Html.DisplayFor(modelItem => product.ProductImage)" />
                        </a>
                    </div>
                    <div>
                        <h5>@Html.DisplayFor(modelItem => product.ProductName)</h5>
                        <p class="prodPrice">@Html.DisplayFor(modelItem => product.ProductPrice)</p>
                        <p class="prodCate">@Html.DisplayFor(modelItem => product.Category.CategoryName)</p>
                        <p class="prodSale">Đã bán: @Html.DisplayFor(modelItem => product.OrderDetails.Count)</p>
                    </div>
                </div>
            }
        </div>
    </section>
}