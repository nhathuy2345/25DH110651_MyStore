<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - TRANG QUẢN TRỊ</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        .admin-navbar { background-color: #343a40; }
        .admin-navbar .navbar-brand { color: #fff !important; font-weight: bold; }
        .admin-navbar .nav-link { color: #d1d1d1 !important; font-weight: 500; }
        .admin-navbar .nav-link:hover { color: #fff !important; }
        body { background-color: #f4f6f9; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg admin-navbar shadow-sm">
        <div class="container-fluid">
            <a class="navbar-brand" href="@Url.Action("Index", "Home", new { area = "Admin" })">My Store Admin</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#adminMenu"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="adminMenu">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Home", new { area = "Admin" })">Trang chủ</a></li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Categories", new { area = "Admin" })">Danh mục</a></li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Products", new { area = "Admin" })">Sản phẩm</a></li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Customers", new { area = "Admin" })">Khách hàng</a></li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Orders", new { area = "Admin" })">Đơn hàng</a></li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Users", new { area = "Admin" })">Tài khoản</a></li>
                </ul>
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link text-warning" href="@Url.Action("Logout", "Account", new { area = "" })">Đăng xuất</a></li>
                </ul>
            </div>
        </div>
    </nav>
    <div class="container-fluid mt-4">@RenderBody()</div>
    <footer class="text-center text-muted py-4 mt-5 border-top">
        <p class="mb-1">&copy; 2024 - Tên ứng dụng</p>
        <p class="mb-1">Contact: 0123456789</p>
    </footer>
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>